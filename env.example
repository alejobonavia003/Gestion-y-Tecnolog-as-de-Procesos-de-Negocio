# Copiar a .env. En instalaciones existentes, conservar las claves del volumen.
POSTGRES_DB=flowable
POSTGRES_USER=flowable
POSTGRES_PASSWORD=cambiar-clave-local
INSTITUCION_DB_NAME=institucion
# Usuario técnico de la API REST de Flowable. Ajustar a la instalación.
FLOWABLE_REST_USUARIO=admin
FLOWABLE_REST_CLAVE=test
FLOWABLE_PROCESO_CLAVE=process
CURSOS_DATOS_DEMO=false
