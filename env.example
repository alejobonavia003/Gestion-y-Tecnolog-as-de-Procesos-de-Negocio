# Plantilla de variables para docker compose.

# Base de datos del motor Flowable
POSTGRES_DB=flowable
POSTGRES_USER=flowable
POSTGRES_PASSWORD=cambiar-esta-clave

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambiar-esta-clave

# Backend: usuario técnico para llamar a la API REST de Flowable
FLOWABLE_REST_USUARIO=admin
FLOWABLE_REST_CLAVE=cambiar-esta-clave
