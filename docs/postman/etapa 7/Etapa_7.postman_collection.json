            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type application/pdf\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });",
                  "pm.test(\"Archivo PDF válido\", function () { pm.expect(pm.response.text().startsWith(\"%PDF-\")).to.eql(true); });"
                ]
              }
            }
          ]
        },
