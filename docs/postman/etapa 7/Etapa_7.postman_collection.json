    {
      "name": "03 - Registrar propuesta v1 y descargar PDF",
      "description": "Crea la versión 1 de la propuesta, genera el PDF en disco y completa la tarea en Flowable.",
      "item": [
        {
          "name": "01 Registrar propuesta inicial v1 (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tareas/{{taskId}}/propuesta",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programa\": \"Módulo 1: Introducción a Contenedores.\\nMódulo 2: Orquestación con Kubernetes.\\nMódulo 3: Práctica guiada.\",\n  \"presupuesto\": {\n    \"importe\": \"150000.00\",\n    \"moneda\": \"ARS\"\n  },\n  \"fechasPosibles\": [\n    \"2026-12-01T09:00:00-03:00\",\n    \"2026-12-08T09:00:00-03:00\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {\n  const r = pm.response.json();\n  pm.test(\"Versión 1 y PDF disponible\", function () { pm.expect(r.propuestaVersion).to.eql(1); pm.expect(r.pdfDisponible).to.eql(true); });\n  pm.environment.set(\"propuestaVersion\", r.propuestaVersion);\n}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Listar propuestas del curso",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/propuestas",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Contiene versión 1\", function () {\n  const items = pm.response.json().items;\n  pm.expect(items).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(items[0].version).to.eql(1);\n  pm.expect(items[0].estado).to.eql(\"ENVIADA\");\n});"
                ]
              }
            }
          ]
        },
