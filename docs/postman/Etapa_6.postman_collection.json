                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tareas/{{taskId}}/completado",
            "description": "Solo ejecutar con taskId de registrar_elaborar_propuesta/revisar_propuesta asignada al usuario actual.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datos\": {}\n}",
